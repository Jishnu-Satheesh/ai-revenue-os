# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=development

# Supabase (never expose the service-role key to browser code)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key

# AI providers (server-only; add only what is configured)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
AI_DEFAULT_MODEL=

# Trigger.dev
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=

# Integration Hub rollout (server-only). Comma-separated organization UUIDs.
# An organization outside this list cannot open the Hub, call its APIs, or be
# processed by its workers, whatever the navigation shows.
INTEGRATION_HUB_V1_ORGANIZATION_IDS=

# Authenticated Integration Hub end-to-end tests. Leave unset to skip them.
E2E_INTEGRATION_ORGANIZATION_ID=
E2E_OTHER_ORGANIZATION_ID=
E2E_OPERATOR_EMAIL=
E2E_OPERATOR_PASSWORD=
E2E_VIEWER_EMAIL=
E2E_VIEWER_PASSWORD=

# Observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
