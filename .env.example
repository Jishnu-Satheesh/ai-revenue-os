# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=development

# Supabase (never expose the service-role key to browser code)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key

# AI providers (server-only; add only what is configured)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
AI_DEFAULT_MODEL=

# Trigger.dev
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=

# Integration Hub rollout (server-only). Comma-separated organization UUIDs.
# An organization outside this list cannot open the Hub, call its APIs, or be
# processed by its workers, whatever the navigation shows.
INTEGRATION_HUB_V1_ORGANIZATION_IDS=
GOVERNED_REPORT_VALIDATION_ORGANIZATION_IDS=
GOVERNED_REPORT_PROJECTION_ORGANIZATION_IDS=
# Comma-separated organization IDs that see governed economics evidence readiness.
# Unset means off for everyone, which is the intended default.
GOVERNED_ECONOMICS_READINESS_ORGANIZATION_IDS=
# Comma-separated organization IDs that may run and read governed channel analysis.
GOVERNED_CHANNEL_ANALYSIS_ORGANIZATION_IDS=

# Authenticated Integration Hub end-to-end tests. Leave unset to skip them.
E2E_INTEGRATION_ORGANIZATION_ID=
E2E_OTHER_ORGANIZATION_ID=
E2E_OPERATOR_EMAIL=
E2E_OPERATOR_PASSWORD=
E2E_VIEWER_EMAIL=
E2E_VIEWER_PASSWORD=

# Observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Business Memory (both optional; absence disables the feature they configure)
# With no embedding model configured retrieval runs lexical-only and says so.
MEMORY_EMBEDDING_MODEL=text-embedding-3-small
# With no cache configured every read goes straight to Postgres.
REDIS_URL=

# Meta application identity (server-only; configure both or neither).
# Holding these does not make Meta usable: every Meta action stays blocked
# until a verified provider contract and a per-organization capability grant
# prove eligibility.
META_APP_ID=
META_APP_SECRET=

# Campaign rollout allowlist (comma-separated organization UUIDs).
# Fail-closed: unset enables nobody. Campaigns can publish to a public account
# and spend money, so "we forgot to configure it" must mean off.
CAMPAIGNS_V1_ORGANIZATION_IDS=

# Campaign generation runs on Google Gemini and reuses the existing
# GOOGLE_GENERATIVE_AI_API_KEY above.
# Campaign generation models, routed per task (see src/ai/model-router.ts).
# There is deliberately no built-in default: a silent fallback would let
# production generate with a model nobody chose, making cost, quality, and
# content-policy behaviour a surprise rather than a decision.
#
# CAMPAIGN_TEXT_MODEL is the shared default for every text task. The per-task
# variables below override it where one job wants a different model — a cheaper
# one for mechanical patches, a stronger one for planning.
CAMPAIGN_TEXT_MODEL=
CAMPAIGN_PLAN_MODEL=
CAMPAIGN_PATCH_MODEL=
CAMPAIGN_REPAIR_MODEL=
CAMPAIGN_IMAGE_MODEL=


# Upstash Redis for caching
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=