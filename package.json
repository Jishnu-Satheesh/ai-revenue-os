{
  "name": "ai-revenue-os",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write package.json next.config.ts eslint.config.mjs playwright.config.ts trigger.config.ts 'src/**/*.{ts,tsx}'",
    "format:check": "prettier --check package.json next.config.ts eslint.config.mjs playwright.config.ts trigger.config.ts 'src/**/*.{ts,tsx}'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "knip": "knip --include files,dependencies,unlisted,binaries,duplicates",
    "knip:all": "knip",
    "test:e2e": "playwright test",
    "supabase:start": "supabase start",
    "supabase:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "db:migrations:list": "supabase migration list --db-url \"$(node scripts/supabase-session-url.mjs)\"",
    "db:migrations:dry-run": "supabase db push --include-all --dry-run --db-url \"$(node scripts/supabase-session-url.mjs)\"",
    "db:migrations:push": "supabase db push --include-all --db-url \"$(node scripts/supabase-session-url.mjs)\"",
    "db:test": "node scripts/run-pgtap.mjs",
    "run:trigger": "pnpm dlx trigger.dev@latest dev",
    "deploy:trigger": "pnpm dlx trigger.dev@latest deploy"
  },
  "dependencies": {
    "@ai-sdk/google": "2.0.0",
    "@date-fns/tz": "^1.5.0",
    "@napi-rs/canvas": "1.0.8",
    "@supabase/ssr": "0.7.0",
    "@supabase/supabase-js": "2.50.0",
    "@tanstack/react-form": "^1.33.3",
    "@tanstack/react-query": "^5.101.4",
    "@trigger.dev/sdk": "4.5.16",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.4",
    "ai": "5.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "csv-parse": "7.0.2",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-rc.4",
    "exceljs": "4.4.0",
    "facebook-nodejs-business-sdk": "24.0.1",
    "fontkit": "2.0.4",
    "framer-motion": "13.0.0",
    "lucide-react": "0.468.0",
    "next": "16.0.10",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.2.108",
    "postgres": "^3.4.9",
    "pure-rand": "^8.4.2",
    "radix-ui": "^1.6.7",
    "react": "19.2.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.0",
    "recharts": "3.8.0",
    "resend": "^6.20.0",
    "server-only": "0.0.1",
    "shadcn": "^4.16.2",
    "sharp": "0.35.3",
    "simple-statistics": "^7.9.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "2.6.0",
    "tldts": "7.4.11",
    "tus-js-client": "4.3.1",
    "tw-animate-css": "^1.4.0",
    "yauzl": "3.4.0",
    "zod": "4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@tailwindcss/postcss": "4.1.10",
    "@tanstack/react-query-devtools": "5.101.4",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "^14.6.7",
    "@trigger.dev/build": "4.5.16",
    "@types/facebook-nodejs-business-sdk": "24.0.0",
    "@types/fontkit": "^2.0.9",
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "@types/yauzl": "3.4.0",
    "@vitest/coverage-v8": "^2.1.8",
    "chrome-devtools-mcp": "^1.7.0",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "9.17.0",
    "eslint-config-next": "16.0.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "fast-check": "^4.9.0",
    "jsdom": "30.0.1",
    "knip": "^6.32.0",
    "msw": "^2.15.0",
    "prettier": "3.4.2",
    "supabase": "2.112.0",
    "tailwindcss": "4.1.10",
    "trigger.dev": "4.5.16",
    "tsx": "^4.23.10",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
