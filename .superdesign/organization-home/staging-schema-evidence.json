      "schemaname": "storage",
      "tablename": "objects",
      "policyname": "members can read integration imports",
      "cmd": "SELECT",
      "roles": [
        "authenticated"
      ],
      "qual": "((bucket_id = 'integration-imports'::text) AND (cardinality(storage.foldername(name)) = 3) AND ((storage.foldername(name))[1] ~* '^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$'::text) AND ((storage.foldername(name))[2] ~* '^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$'::text) AND ((storage.foldername(name))[3] ~* '^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$'::text) AND private.is_organization_member(((storage.foldername(name))[1])::uuid) AND (EXISTS ( SELECT 1\n   FROM integration_data_sources source\n  WHERE ((source.organization_id = ((storage.foldername(objects.name))[1])::uuid) AND (source.id = ((storage.foldername(objects.name))[2])::uuid) AND (source.source_type = 'csv_import'::text)))))"
    },
    {
      "schemaname": "storage",
      "tablename": "objects",
      "policyname": "members can read onboarding files",
      "cmd": "SELECT",
      "roles": [
        "authenticated"
      ],
      "qual": "((bucket_id = 'onboarding-files'::text) AND ((storage.foldername(name))[1] ~ '^[0-9a-fA-F-]{36}$'::text) AND private.is_organization_member(((storage.foldername(name))[1])::uuid))"
    },
